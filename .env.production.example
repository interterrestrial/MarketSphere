# ============================================================================
# MarketSphere — Production Environment Variables
# ============================================================================
# Copy to .env.production (gitignored) for local CLI work against production,
# or set the same keys in the Vercel and Render dashboards. NEVER commit the
# filled-in file.
#
# Production PostgreSQL is Neon (region ap-southeast-1).
# ============================================================================

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Use the POOLED endpoint (host contains "-pooler") for runtime traffic:
#   postgresql://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# Keep the DIRECT (non-pooler) URL separately for migrations, seeding and
# pg_dump — a transaction pooler can reject the DDL those need. Export it as
# DIRECT_DATABASE_URL so scripts/render-build.sh uses it.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
# Public URL of the Next.js frontend (Vercel). Also the default CSRF allow-list.
NEXT_PUBLIC_APP_URL="https://marketsphere.vercel.app"

# Express API origin. Inlined into the CSP at BUILD time — changing it needs a
# rebuild, not a restart. Only relevant if the Express service is deployed.
NEXT_PUBLIC_API_URL="https://marketsphere-api.onrender.com"

# Express API port (Render assigns via $PORT).
PORT="3001"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Vercel and Render MUST hold the identical value; a mismatch silently signs
# out every user instead of raising an error. Rotating it invalidates all
# existing sessions, which is the correct response to any exposure.
AUTH_SECRET="CHANGE_ME_TO_A_64_BYTE_HEX_STRING"

# ---------------------------------------------------------------------------
# CSRF / Origin Allow-list
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to make state-changing requests to the
# Express API. NEXT_PUBLIC_APP_URL is always allowed; add extra origins here.
# Browser writes fail with 403 ORIGIN_REJECTED until this matches the live
# frontend domain.
CSRF_ALLOWED_ORIGINS="https://marketsphere.vercel.app"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"

# Enables HSTS on both stacks, and makes the rate-limit bypass in
# RATE_LIMIT_DISABLED a no-op. Never set this to "development" in production.
NODE_ENV="production"

# ---------------------------------------------------------------------------
# Rate limiting (tests only)
# ---------------------------------------------------------------------------
# Set to "true" ONLY in the automated test suite, where many requests share
# one IP. It is ignored entirely when NODE_ENV=production, so it cannot
# switch protection off on a live deployment.
# RATE_LIMIT_DISABLED="true"

# ---------------------------------------------------------------------------
# File Storage (future — no upload endpoint exists yet)
# ---------------------------------------------------------------------------
# Product images are stored as external http(s) URLs. Nothing reads these yet;
# they are reserved for the upload feature.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""