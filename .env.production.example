# ============================================================================
# MarketSphere — Production Environment Variables
# ============================================================================
# Copy this to .env.production (or set in Render / Vercel dashboards).
# NEVER commit the filled-in file to git.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Render provides this automatically when you add a PostgreSQL service.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://marketsphere:CHANGE_ME@HOST:5432/marketsphere_prod?sslmode=require"

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
# The public URL of the Next.js frontend (Vercel).
NEXT_PUBLIC_APP_URL="https://marketsphere.vercel.app"

# Express API port (Render auto-assigns via the PORT env var).
PORT="3001"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET="CHANGE_ME_TO_A_64_BYTE_HEX_STRING"

# ---------------------------------------------------------------------------
# CSRF / Origin Allow-list
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to make state-changing requests
# to the Express API. Must include the Vercel frontend URL.
CSRF_ALLOWED_ORIGINS="https://marketsphere.vercel.app"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="production"

# ---------------------------------------------------------------------------
# File Storage (future — leave empty for now)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
