{
  "name": "marketsphere",
  "version": "0.1.0",
  "private": true,
  "description": "A B2B marketplace connecting micro and small enterprises with business buyers",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' src/server/index.ts",
    "server:watch": "ts-node --watch --compilerOptions '{\"module\":\"commonjs\"}' src/server/index.ts",
    "dev:all": "concurrently \"next dev\" \"npm run server:watch\"",
    "electron:dev": "concurrently \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.2.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.3"
  }
}
