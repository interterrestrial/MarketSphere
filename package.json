{
  "name": "marketsphere",
  "version": "0.1.0",
  "private": true,
  "description": "A B2B marketplace connecting micro and small enterprises with business buyers",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "server": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' src/server/index.ts",
    "server:watch": "ts-node --watch --compilerOptions '{\"module\":\"commonjs\"}' src/server/index.ts",
    "dev:all": "concurrently \"next dev\" \"npm run server:watch\"",
    "electron:dev": "concurrently \"next dev\" \"npm run electron:bundle && wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run electron:bundle && electron-builder --mac dmg --arm64 && electron-builder --mac dmg --x64",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:frontend": "vitest run --project frontend",
    "test:watch": "vitest",
    "test:db:setup": "node tests/db-setup.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' prisma/seed.ts",
    "admin:create": "ts-node --compilerOptions '{\"module\":\"commonjs\"}' scripts/create-admin.ts",
    "electron:start": "electron .",
    "electron:pack": "npm run electron:bundle && electron-builder --dir",
    "electron:icon": "node tools/make-icon.mjs",
    "electron:verify": "./scripts/verify-desktop-build.sh",
    "electron:bundle": "node tools/build-preload.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.2.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "prisma": "^6.4.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "in.marketsphere.desktop",
    "productName": "MarketSphere",
    "copyright": "Copyright (c) 2026 MarketSphere",
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/dist/preload.js",
      "electron/lib/navigation-policy.js",
      "package.json",
      "!node_modules/**/*",
      "!.env",
      "!.env.*"
    ],
    "extraMetadata": {
      "main": "electron/main.js",
      "dependencies": null,
      "devDependencies": {}
    },
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "packaging/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist"
    },
    "afterSign": "packaging/notarize.js",
    "dmg": {
      "title": "${productName} ${version}",
      "backgroundColor": "#f6f7f9",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "author": {
    "name": "MarketSphere",
    "email": "ops@marketsphere.in"
  }
}
