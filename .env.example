# Local development. Copy to .env and fill in.
# For production values see .env.production.example.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local PostgreSQL. Integration tests use a separate *_test database — see
# docs/Testing-and-Security.md — so this one is never truncated by the suite.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketsphere"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public frontend URL; also the default CSRF allow-list.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Standalone Express API server port.
PORT="3001"

# Express API URL. Inlined into the Content-Security-Policy at build time, so
# changing it requires restarting `next dev` or rebuilding.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Logger verbosity: debug | info | warn | error
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Any long random string for development. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Tests use their own fixed key from tests/setup/, never this one.
AUTH_SECRET="replace-with-a-secure-random-secret"

# ---------------------------------------------------------------------------
# CSRF / Origin Allow-list
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to make state-changing requests to the
# Express API. http://localhost:3000 is always allowed, so this can stay empty
# locally; add extra origins if you run a second frontend on another port.
CSRF_ALLOWED_ORIGINS=""

# ---------------------------------------------------------------------------
# Node environment (development | production)
# ---------------------------------------------------------------------------
# In production this also enables HSTS and makes RATE_LIMIT_DISABLED inert.
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Rate limiting (tests only)
# ---------------------------------------------------------------------------
# Set only in the automated test suite, where many requests share one IP and
# would otherwise trip the shared limiter. Ignored when NODE_ENV=production.
# RATE_LIMIT_DISABLED="true"

# ---------------------------------------------------------------------------
# File Storage (future — no upload endpoint exists yet)
# ---------------------------------------------------------------------------
# Product images are stored as external http(s) URLs; nothing reads these yet.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""