# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketsphere"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Standalone Express API server port (Phase 0 health-check API)
PORT="3001"

# Authentication (required from Phase 1 onwards)
AUTH_SECRET="replace-with-a-secure-random-secret"

# File Storage
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
