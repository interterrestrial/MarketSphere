# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketsphere"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Standalone Express API server port (Phase 0 health-check API)
PORT="3001"

# Logger verbosity: debug | info | warn | error
LOG_LEVEL="info"

# Authentication (required from Phase 1 onwards)
AUTH_SECRET="replace-with-a-secure-random-secret"

# File Storage
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Express API URL (used by Next.js CSP connect-src; default: http://localhost:3001)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# CSRF origin allow-list (comma-separated; Express API checks Origin/Referer)
CSRF_ALLOWED_ORIGINS=""

# Node environment (development | production)
NODE_ENV="development"
